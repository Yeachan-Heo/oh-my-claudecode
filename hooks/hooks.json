{
  "description": "OMC orchestration hooks with async capabilities",
  "modules": ["./jev-compaction.mjs"],
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 30,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/keyword-detector.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 30,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/skill-injector.mjs"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/project-memory-session.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/wiki-session-start.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/stale-run-reporter.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/runs-reconciler.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "init",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 30,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/setup-init.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "maintenance",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 60,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/setup-maintenance.mjs"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 60,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/pre-tool-enforcer.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/git-guardrails.mjs"
            ]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/permission-handler.mjs"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-verifier.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 3,
            "async": true,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/project-memory-posttool.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 3,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-rules-injector.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 3,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-directory-context-injector.mjs"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 3,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-use-failure.mjs"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 3,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/subagent-tracker.mjs",
              "start"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/subagent-tracker.mjs",
              "stop"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/verify-deliverables.mjs"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/pre-compact.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/project-memory-precompact.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 3,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/wiki-pre-compact.mjs"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/context-guard-stop.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 3,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/workflow-drift-guard.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 20,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/persistent-mode.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/budget-guard.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/code-simplifier.mjs"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 30,
            "async": true,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-end.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 30,
            "async": true,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.cjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/wiki-session-end.mjs"
            ]
          }
        ]
      }
    ]
  }
}
