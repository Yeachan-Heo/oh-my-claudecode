# Release body is generated dynamically — never commit stale copies
.github/release-body.md

# dist/ and bridge/ are tracked release artifacts (git-based plugin installs
# consume them); these rules only stop NEW build outputs from being added
# accidentally. Release tooling stages tracked-file changes via `git add -A`.
# A new src module's dist output must be added with `git add -f`.
dist/
bridge/

__pycache__/
*.py[cod]
