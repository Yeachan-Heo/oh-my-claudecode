stateDiagram-v2
  direction LR
  state "At the same time" as all {
    state "Playback" as r0 {
      s0: Stopped
      s1: Buffering
      s2: Playing
      s3: Paused
      [*] --> s0
      s0 --> s1: you press play
      s1 --> s0: you press stop
      s1 --> s2: enough data arrives
      s2 --> s0: the track ends or you press stop
      s2 --> s1: the network slows
      s2 --> s3: a call comes in or you press pause
      s3 --> s0: you press stop
      s3 --> s2: you press play
    }
    --
    state "Volume" as r1 {
      s4: Normal volume
      s5: Muted
      s6: Loud
      [*] --> s4
      s4 --> s5: a call comes in or you press mute
      s5 --> s4: the call ends or you press mute
      s4 --> s6: you turn it up [unless Stopped]
      s6 --> s4: you press stop or the track ends or you turn it down
      s6 --> s5: a call comes in or you press mute
    }
  }
